{% if project_kind == "published_library" -%}
[package]
name = "{{ project_name }}"
version = "0.1.0"
edition = "2024"
rust-version = "{{ rust_version }}"
license = "{{ license_expression }}"
readme = "README.md"
publish = true
# What crates.io shows and searches. `cargo publish` refuses a package with no
# description, and `clippy::cargo` fails the build when any of the rest is
# missing.
description = "{{ project_description | trim }}"
repository = "https://github.com/{{ github_owner }}/{{ project_name }}"
documentation = "https://docs.rs/{{ project_name }}"
keywords = [{% for keyword in keywords.split(",") %}"{{ keyword | trim }}"{{ ", " if not loop.last }}{% endfor %}]
categories = [{% for category in categories.split(",") %}"{{ category | trim }}"{{ ", " if not loop.last }}{% endfor %}]
# What `cargo package` uploads. Entries are gitignore-style patterns, each
# anchored with a leading `/` — a bare `README.md` would match at any depth.
include = [
    "/src/",
    "/README.md",
    "/LICENSE*",
]

# How docs.rs builds this crate's page. Without `all-features` it builds the
# default features only, and every feature-gated item is silently missing
# from the published documentation.
#
# `--cfg docsrs` turns on a cfg only docs.rs sets, so
# `#[cfg_attr(docsrs, doc(cfg(feature = "..")))]` on a gated item prints the
# feature that turns it on. Declared in `check-cfg` below so a cfg no local
# build sets does not read as a typo.
[package.metadata.docs.rs]
all-features = true
rustdoc-args = ["--cfg", "docsrs"]

[lints]
workspace = true

[workspace]
resolver = "3"
members = ["xtask"]
default-members = ["."]
# Its own workspace on purpose — it depends on this crate the way a stranger
# would, and a member would instead share this one's resolved dependencies.
{% if fuzzing -%}
# The fuzz harness too: cargo-fuzz builds it with nightly sanitizer flags,
# and its libFuzzer runtime belongs in neither this lockfile nor the gate.
exclude = ["fixtures/consumer", "fuzz"]
{% else -%}
exclude = ["fixtures/consumer"]
{% endif -%}
{% else -%}
[workspace]
resolver = "3"
# `crates/*` matches nothing yet and costs nothing until it does: the shape a
# workspace grows into is libraries doing the work and applications wiring
# them together.
members = ["crates/*", "apps/*", "xtask"]

# No `rust-version`: an MSRV is a promise to whoever compiles this code, and
# nobody compiles an application — they run the binaries it ships. The floor
# here is the toolchain pinned in rust-toolchain.toml.
[workspace.package]
version = "0.1.0"
edition = "2024"
license = "{{ license_expression }}"
publish = false
description = "{{ project_description | trim }}"
# Not for a registry — `dist` reads it to know where the releases it builds
# are hosted, and refuses to initialize without it.
repository = "https://github.com/{{ github_owner }}/{{ project_name }}"

# Every dependency declared once here and taken with `{ workspace = true }` in
# the member that uses it. Scattered requirements drift toward incompatible
# versions and feature sets — invisibly, until two members disagree about a
# type they both pass around.
[workspace.dependencies]
{% endif %}
# `typos` reads its configuration from here rather than from a file of its
# own.
#
# `target/` is excluded because typos otherwise reports the hashed filenames
# in the build directory. It skips gitignored paths on its own, but only
# inside a repository — and `cargo xtask ci` has to pass before `git init`
# as much as after it.
#
# A word that only looks like a typo — a misspelled protocol field, a domain
# term, somebody's surname — is mapped to itself, recording the decision:
#
#   [workspace.metadata.typos.default.extend-words]
#   <the word> = "<the same word>"
[workspace.metadata.typos.files]
extend-exclude = ["target/"]

# Declared once for the whole workspace, and inherited by every member through
# `[lints] workspace = true`. A member that sets its own would be exempt from
# whatever is tightened here later, silently.
[workspace.lints.rust]
unsafe_code = "{{ 'deny' if unsafe_policy == 'deny' else 'warn' }}"
unsafe_op_in_unsafe_fn = "warn"
ambiguous_negative_literals = "warn"
missing_debug_implementations = "warn"
# An undocumented public item is an item nobody outside this repository can
# use. Enforced here rather than at review, which forgets. It reaches build
# scripts too: a build.rs is a crate of its own and owes a `//!` header.
missing_docs = "warn"
redundant_imports = "warn"
redundant_lifetimes = "warn"
trivial_numeric_casts = "warn"
unused_lifetimes = "warn"
# Cargo already tells the compiler every feature name declared here, so a
# `#[cfg(feature = "serd")]` typo is caught without configuration. A cfg set
# outside Cargo — by a build script, RUSTFLAGS, or another builder — reads as
# exactly that typo. Declare each as it appears.
{% if project_kind == "published_library" -%}
# `docsrs` is the one this crate already has: docs.rs sets it, no local build
# does, and it is what `#[cfg_attr(docsrs, doc(cfg(..)))]` hangs on.
unexpected_cfgs = { level = "warn", check-cfg = ['cfg(docsrs)'] }
{% else -%}
#
#   unexpected_cfgs = { level = "warn", check-cfg = ['cfg(coverage_nightly)'] }
{% endif -%}
# Not enabled: `dead_code_pub_in_binary` (1.97), which catches `pub` items a
# binary cannot export. Under `--all-targets` — which every xtask task passes
# — a library's test harness counts as a binary to it, and every public item
# of every library crate is reported as dead. Until the lint learns the
# difference, enabling it costs a hundred false positives on the first
# library this workspace grows.

# One decision per group, made once. `priority = -1` is what lets the
# individual lints below override the level set for the group they belong to.
[workspace.lints.clippy]
correctness = { level = "deny", priority = -1 }
suspicious = { level = "warn", priority = -1 }
complexity = { level = "warn", priority = -1 }
perf = { level = "warn", priority = -1 }
style = { level = "warn", priority = -1 }
{% if clippy_pedantic -%}
# Enabled whole rather than cherry-picked, because cherry-picking means never
# seeing the pedantic lints added later. The two below are the ones almost
# everybody turns back off; disagree with another by adding it beside them.
#
# Not `module_name_repetitions`, the third name usually found in a list like
# this one: clippy moved it to `restriction`, where it is off unless something
# names it. Written here it would allow a lint that was never on.
pedantic = { level = "warn", priority = -1 }
must_use_candidate = "allow"
cast_precision_loss = "allow"
{% endif -%}
{% if project_kind == "published_library" -%}
# Problems that only bite at publish time — missing metadata, a wildcard
# version requirement. An application workspace publishes nothing, so it
# skips this group.
cargo = { level = "warn", priority = -1 }
# The exception in that group: two semver-major copies of one crate is a fact
# about somebody else's dependency tree, and can arrive on a day this project
# changed nothing. Inspect it with `cargo tree --duplicates`, not a build
# that stops.
multiple_crate_versions = "allow"
{% endif -%}
# Individually chosen from `restriction` and `nursery`, which are menus rather
# than groups and must never be enabled wholesale.
allow_attributes_without_reason = "warn"
as_pointer_underscore = "warn"
assertions_on_result_states = "warn"
clone_on_ref_ptr = "warn"
deref_by_slicing = "warn"
disallowed_script_idents = "warn"
empty_drop = "warn"
empty_enum_variants_with_brackets = "warn"
empty_structs_with_brackets = "warn"
fn_to_numeric_cast_any = "warn"
if_then_some_else_none = "warn"
map_err_ignore = "warn"
# One module layout, picked here so the second multi-file module cannot pick
# the other one. `foo.rs` beside `foo/`, which is what this bans `mod.rs` in
# favor of: the file is then named after the module in the file tree as well
# as in the source, and a directory of `mod.rs` tabs is nobody's idea of an
# editor.
mod_module_files = "warn"
redundant_type_annotations = "warn"
renamed_function_params = "warn"
# Not `semicolon_outside_block`: on a single-statement block no spelling
# satisfies everything at once. It reads `{ v.push(1); }` and asks for the
# semicolon outside; `unnecessary_operation`, which is on by default, reads
# the `{ v.push(1) };` that produces and asks for the braces gone.
too_long_first_doc_paragraph = "warn"
undocumented_unsafe_blocks = "warn"
unnecessary_safety_comment = "warn"
unnecessary_safety_doc = "warn"
unneeded_field_pattern = "warn"
unused_result_ok = "warn"
# Left behind rather than written: a debugging aid, a placeholder, or a
# message that went to the wrong place. None of them is a style opinion.
dbg_macro = "warn"
todo = "warn"
{% if project_kind == "published_library" -%}
# A library writes to a writer its caller chose. Printing to the process's
# stdout takes that choice away, and there is no way to take it back.
print_stdout = "warn"
{% endif -%}
# Both, because both are the same decision: this cannot fail, and if it does
# the process ends. What matters is that the reason is written down, and
# `#[expect(clippy::unwrap_used, reason = "...")]` is where it gets written —
# these two lints are what make somebody write it.
#
# Only one of them was on here once, and it was the wrong one: with `unwrap`
# unlinted and `expect` denied, the construct carrying no reason at all was
# the one that compiled.
unwrap_used = "warn"
expect_used = "warn"
# Would fire on every structured-logging call site.
literal_string_with_formatting_args = "allow"

# Rustdoc's own lints. A broken intra-doc link silently stops linking rather
# than stopping the build — denied here and through RUSTDOCFLAGS in
# `cargo xtask docs`.
[workspace.lints.rustdoc]
broken_intra_doc_links = "deny"
private_intra_doc_links = "warn"
invalid_html_tags = "warn"
unescaped_backticks = "warn"
{% if project_kind == "published_library" %}
# The two profiles a library sets, and both are about developing it. Cargo
# reads profiles from the workspace root only, so consumers never see these —
# a library imposes no build settings on them.

# Dependencies dominate a debug build's runtime and rarely change. This crate
# stays at `opt-level = 0`, where a debugger can still follow it.
[profile.dev.package."*"]
opt-level = 3

# Symbols and line numbers kept: a profiler that cannot name a function has
# measured something nobody can act on.
#
# No `[profile.release]` above it. `bench` inherits release, so an
# `overflow-checks = true` there would be measured by every benchmark and by
# nothing that ships — and what ships is built with the consumer's profile
# anyway.
[profile.bench]
debug = true
strip = false
{% else %}
# Dependencies dominate a debug build's runtime and rarely change.
[profile.dev.package."*"]
opt-level = 3

[profile.release]
opt-level = 3
lto = "thin"
codegen-units = 16
debug = "line-tables-only"
# Keeps the symbol table, so a backtrace still names functions.
strip = "debuginfo"
# Silent wraparound becomes a panic. A wrong number is worse than a crash.
overflow-checks = true

# The artifact actually shipped, and what `dist` builds. Slow on purpose:
# fat LTO with one codegen unit multiplies link time — a bad trade on every
# developer build, a good one on the binary that goes out.
#
# `panic = "abort"` belongs here too — but only once nothing in the tree
# depends on unwinding, because it makes `catch_unwind` do nothing.
[profile.dist]
inherits = "release"
lto = "fat"
codegen-units = 1

[profile.bench]
inherits = "release"
debug = true
strip = false
{% endif -%}
