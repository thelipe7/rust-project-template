/// Returns the package name generated by the project template.
///
/// # Examples
///
/// ```
/// assert_eq!({{ project_name | replace("-", "_") }}::package_name(), "{{ project_name }}");
/// ```
#[must_use]
pub const fn package_name() -> &'static str {
    "{{ project_name }}"
}
