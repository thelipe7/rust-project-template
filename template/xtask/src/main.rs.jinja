//! The workspace's task runner.
//!
//! One entry point for everything a change has to pass — `cargo xtask
//! <check|lint|features|test|docs|bench|fuzz|{{ "package" if project_kind == "published_library" else "dist" }}|ci>` — so that what CI runs
//! and what a developer runs cannot drift apart. Written in Rust rather than
//! as a shell script or a Makefile because it is then built and checked by the
//! same toolchain as the code it verifies.
//!
//! `ci` runs them in order, which is what a developer wants from one command.
//! CI calls the tasks separately, one job each, because they do not depend on
//! each other and a runner that waits for the previous one is a runner idle
//! for as long as that one takes.

use std::env;
use std::ffi::OsStr;
use std::fs;
use std::path::{Path, PathBuf};
use std::process::{Command, ExitCode, Stdio};

/// Whether a variable is Cargo describing xtask to itself.
///
/// A child `cargo <subcommand>` inherits these variables and reads them as
/// proof it was launched by `cargo run`: `cargo-machete` checks
/// `CARGO_PKG_NAME` for exactly that and then takes its own name, `machete`,
/// for a directory to scan. Every child here is a fresh invocation from the
/// workspace root, so hand it the environment such an invocation would have.
fn describes_xtask_to_itself(variable: &str) -> bool {
    variable.starts_with("CARGO_PKG_")
        || matches!(
            variable,
            "CARGO_CRATE_NAME"
                | "CARGO_BIN_NAME"
                | "CARGO_MANIFEST_DIR"
                | "CARGO_MANIFEST_PATH"
                | "CARGO_PRIMARY_PACKAGE"
        )
}

fn command<I, S>(program: &str, args: I) -> Result<(), String>
where
    I: IntoIterator<Item = S>,
    S: AsRef<OsStr>,
{
    execute(program, args, &[], None)
}

fn command_with_env<I, S>(
    program: &str,
    args: I,
    environment: &[(&str, &str)],
) -> Result<(), String>
where
    I: IntoIterator<Item = S>,
    S: AsRef<OsStr>,
{
    execute(program, args, environment, None)
}

/// Runs a command from inside `directory` rather than the workspace root.
///
/// For a crate that is its own workspace, which no flag from here can reach:
/// `--manifest-path` still resolves the workspace it is run from, so the only
/// way into one is to stand in it.
fn command_in<I, S>(directory: &Path, program: &str, args: I) -> Result<(), String>
where
    I: IntoIterator<Item = S>,
    S: AsRef<OsStr>,
{
    execute(program, args, &[], Some(directory))
}

fn execute<I, S>(
    program: &str,
    args: I,
    environment: &[(&str, &str)],
    directory: Option<&Path>,
) -> Result<(), String>
where
    I: IntoIterator<Item = S>,
    S: AsRef<OsStr>,
{
    let mut child = Command::new(program);
    child.args(args);
    if let Some(directory) = directory {
        child.current_dir(directory);
    }
    for (variable, _) in env::vars() {
        if describes_xtask_to_itself(&variable) {
            child.env_remove(&variable);
        }
    }
    for (variable, value) in environment {
        child.env(variable, value);
    }

    let status = child
        .status()
        .map_err(|error| format!("failed to start `{program}`: {error}"))?;

    if status.success() {
        Ok(())
    } else {
        Err(format!("`{program}` exited with {status}"))
    }
}

fn cargo<const N: usize>(args: [&str; N]) -> Result<(), String> {
    command("cargo", args)
}
{% if project_kind != "published_library" %}
/// Whether any crate under `crates/` carries a library, and so a doctest.
///
/// An application workspace starts with none, and grows them as the work that
/// deserves testing without a binary around it moves out of `apps/`.
fn workspace_has_a_library() -> bool {
    std::fs::read_dir("crates").is_ok_and(|entries| {
        entries
            .flatten()
            .any(|entry| entry.path().join("src/lib.rs").is_file())
    })
}
{% endif %}
/// Every fuzz crate in the repository, in a stable order.
///
/// Found rather than listed, so that a crate growing a fuzz target is covered
/// by having one rather than by somebody remembering this function. Both
/// layouts: `fuzz/` at the root, which is what the scaffold writes, and
/// `crates/<name>/fuzz`, which is what a workspace grows by hand.
///
/// A missing `crates/` directory is swallowed rather than reported: a
/// single-crate project does not have one, and its absence is not an error.
fn fuzz_crates() -> Vec<PathBuf> {
    let mut found: Vec<PathBuf> = std::fs::read_dir("crates")
        .into_iter()
        .flatten()
        .flatten()
        .map(|entry| entry.path().join("fuzz"))
        .chain(std::iter::once(PathBuf::from("fuzz")))
        .filter(|path| path.join("Cargo.toml").is_file())
        .collect();
    found.sort();
    found
}

/// Every `Cargo.toml` in the repository, in a stable order.
///
/// Found rather than listed, so that a crate added later is covered by
/// existing rather than by somebody remembering this function. `target/` and
/// `.git/` are skipped for the reason the `typos` configuration skips them:
/// one holds vendored manifests nobody here wrote, the other is not prose.
fn manifests(directory: &Path) -> Vec<PathBuf> {
    let mut found = Vec::new();
    let Ok(entries) = fs::read_dir(directory) else {
        return found;
    };
    for entry in entries.flatten() {
        let path = entry.path();
        if path.is_dir() {
            if !matches!(
                path.file_name().and_then(OsStr::to_str),
                Some("target" | ".git")
            ) {
                found.extend(manifests(&path));
            }
        } else if path.file_name() == Some(OsStr::new("Cargo.toml")) {
            found.push(path);
        }
    }
    found.sort();
    found
}

/// Spell-checks the manifests, which `typos` walking the tree does not read.
///
/// `typos` carries a built-in `lock` file type with checking switched off, and
/// its glob list has `Cargo.toml` in it beside `Cargo.lock` — so a misspelling
/// in a manifest survives the gate. For a published crate that is the
/// `description` shown on its registry page.
///
/// There is no configuration that turns this back on: the built-in type wins
/// over a `[type]` table naming the same glob, and re-enabling `lock` itself
/// would take `Cargo.lock` and every other lockfile with it. Standard input is
/// the way past it — `typos` reads what it is handed without consulting the
/// name it came from. The cost is the report: every finding points at `-`.
///
/// Built here rather than through `execute`, which has no stdin to redirect.
/// What `execute` adds is the environment scrub for a child that reads
/// `CARGO_PKG_*` and mistakes xtask for its own package; `typos` reads its
/// configuration and its input, and nothing else.
fn typos_over_manifests() -> Result<(), String> {
    for manifest in manifests(Path::new(".")) {
        let file = fs::File::open(&manifest)
            .map_err(|error| format!("failed to open `{}`: {error}", manifest.display()))?;
        let status = Command::new("typos")
            .arg("-")
            .stdin(Stdio::from(file))
            .status()
            .map_err(|error| format!("failed to start `typos`: {error}"))?;
        if !status.success() {
            return Err(format!(
                "`typos` rejected `{}` — the report above reads `-`, because \
                 the manifest was fed in through standard input to get past \
                 the filename skip",
                manifest.display()
            ));
        }
    }
    Ok(())
}

{%- if project_kind == "published_library" %}
/// The consumer fixture, which every workspace-wide flag stops short of.
///
/// It has to be its own workspace to depend on this crate the way a stranger
/// does, and that is exactly what puts it outside `--workspace` and `--all` —
/// so the repository ships a Rust file its own gate cannot see unless
/// something stands inside the directory.
const CONSUMER: &str = "fixtures/consumer";

/// Formats the fixture, in `lint` beside the formatter that cannot reach it.
fn consumer_fmt() -> Result<(), String> {
    command_in(
        Path::new(CONSUMER),
        "cargo",
        ["fmt", "--all", "--", "--check"],
    )
}

/// Builds the fixture against this crate, the way a consumer would.
///
/// Run from inside it rather than through `--manifest-path`, so that a flag
/// means what it says: `--all-targets` in a workspace of one is that crate,
/// and read from the root it would be this one.
fn consumer_build() -> Result<(), String> {
    command_in(Path::new(CONSUMER), "cargo", ["build", "--locked"])
}

/// Lints the fixture, in `package` rather than in `lint`.
///
/// This is the arm that already accepts the cost: the fixture shares no
/// `target/` with the workspace, so linting it anywhere else buys a second
/// full build of the dependency tree for one file.
fn consumer_clippy() -> Result<(), String> {
    command_in(
        Path::new(CONSUMER),
        "cargo",
        [
            "clippy",
            "--all-targets",
            "--locked",
            "--",
            "-D",
            "warnings",
        ],
    )
}
{%- endif %}

fn run(task: &str) -> Result<(), String> {
    match task {
        "check" => cargo([
            "check",
            "--workspace",
            "--all-targets",
            "--all-features",
            "--locked",
        ]),
        "lint" => {
            cargo(["fmt", "--all", "--", "--check"])?;
{%- if project_kind == "published_library" %}
            consumer_fmt()?;
{%- endif %}
            // The other two formatters: `taplo` for the TOML nothing else
            // formats, `typos` for the prose and identifiers, where a
            // misspelling survives every check above because it compiles.
            command("taplo", ["fmt", "--check"])?;
            command("typos", [] as [&str; 0])?;
            typos_over_manifests()?;
            cargo([
                "clippy",
                "--workspace",
                "--all-targets",
                "--all-features",
                "--locked",
                "--",
                "-D",
                "warnings",
            ])?;
            // Advisories, licenses and sources — the questions about the
            // dependency tree that compiling it never asks.
            command("cargo", ["deny", "check"])?;
            // Whether a declared dependency is used at all.
            // `unused_crate_dependencies` is allow-by-default, so clippy is
            // equally clean with the dependency and without it.
            command("cargo", ["machete"])
        }
        // Whether each feature compiles on its own. A feature nobody builds in
        // isolation stops compiling and nothing else notices, because every
        // other command here builds `--all-features`.
        //
        // Its own task rather than the tail of `lint`, because it is the one
        // check here that builds the workspace once per feature: it shares no
        // artifacts with anything above it and dominates whatever it is
        // bundled with. Separate, CI gives it a runner of its own.
        //
        // `--offline`, not `--locked`: `--no-dev-deps` hands cargo a temporary
        // manifest without the dev-dependencies table, and `--locked` refuses
        // that re-resolve outright — the two flags cannot coexist once a
        // dev-dependency exists. Offline keeps the spirit: nothing new can be
        // fetched.
        "features" => command(
            "cargo",
            [
                "hack",
                "check",
                "--workspace",
                "--each-feature",
                "--no-dev-deps",
                "--offline",
            ],
        ),
        "test" => {
            // Each test in its own process — see .config/nextest.toml.
            command(
                "cargo",
                [
                    "nextest",
                    "run",
                    "--workspace",
                    "--all-features",
                    "--locked",
                ],
            )?;
{% if project_kind == "published_library" %}
            // The one thing nextest does not run.
            cargo(["test", "--workspace", "--all-features", "--doc", "--locked"])
{% else %}
            // The one thing nextest does not run — and the one that needs a
            // library to run against. `cargo test --doc` fails outright when
            // there is none, so ask first.
            if workspace_has_a_library() {
                cargo(["test", "--workspace", "--all-features", "--doc", "--locked"])
            } else {
                Ok(())
            }
{% endif %}        }
        // Outside the gate, and it stays outside: CI runner variance between
        // two runs of one commit exceeds most wins worth chasing, so a
        // threshold there fails honest changes and passes slow ones. This is
        // for running on one machine, twice, either side of a change.
        //
        // Succeeds with no benchmarks — add a `benches/` target and a
        // harness and it starts measuring.
        "bench" => cargo(["bench", "--workspace", "--all-features", "--locked"]),
        // The fuzz targets, built but not run.
        //
        // Outside the gate, because a fuzzer is a search rather than a check:
        // it answers "not yet" until it answers "here", and neither answer is
        // a thing to hold a change to. Building them is a check, though, and
        // the one that pays: a fuzz crate is a workspace of its own (nightly,
        // a sanitizer), so nothing else in the tree compiles it, and a change
        // to the API a target calls would otherwise break it silently and
        // stay broken until somebody thought to fuzz.
        //
        // Needs cargo-fuzz and a nightly toolchain. `cargo +nightly fuzz run
        // <target>` is how a run is actually started; this only proves the
        // targets still compile.
        "fuzz" => {
            let directories = fuzz_crates();
            if directories.is_empty() {
                eprintln!("no fuzz crate in this repository; nothing to build");
            }
            directories.iter().try_for_each(|directory| {
                command_in(directory, "cargo", ["+nightly", "fuzz", "build"])
            })
        }
        // Warnings denied, because a broken intra-doc link is a doc page that
        // silently stops linking rather than a page that fails to build.
        "docs" => command_with_env(
            "cargo",
            [
                "doc",
                "--workspace",
                "--all-features",
                "--no-deps",
                "--locked",
            ],
            &[("RUSTDOCFLAGS", "-D warnings")],
        ),
{% if project_kind == "published_library" %}
        "package" => {
            // What `cargo publish` would upload, built again from the
            // packaged copy — which is how a file the `include` list forgot
            // is found here rather than by the first person to depend on it.
            cargo(["package", "--allow-dirty", "--locked"])?;
            // And the other half of that question, which packaging cannot
            // answer: whether the public surface works from outside. The
            // fixture depends on this crate the way a stranger would.
            consumer_build()?;
            consumer_clippy()
        }
{% else %}
        // The shippable artifacts for this machine. CI builds the full target
        // matrix from dist-workspace.toml; this is the same pipeline, run
        // once, so a packaging mistake surfaces before a tag exists.
        "dist" => command("dist", ["build"]),
{% endif %}
        "ci" => {
            // First, because a compile error reads better from rustc than
            // from clippy, and the rest of the gate is wasted on a tree that
            // does not build.
            run("check")?;
            run("lint")?;
            run("features")?;
            run("test")?;
{% if project_kind == "published_library" %}
            run("docs")?;
            // In the gate because the two things it checks — what the package
            // contains, and whether that works for a consumer — are only ever
            // wrong at publish time, when it is too late to be told.
            run("package")
{% else %}
            run("docs")
{% endif %}        }
        _ => Err(format!(
            "unknown task `{task}`; expected check, lint, features, test, docs, bench, fuzz, {{ "package" if project_kind == "published_library" else "dist" }}, or ci"
        )),
    }
}

fn main() -> ExitCode {
    let mut args = env::args().skip(1);
    let Some(task) = args.next() else {
        eprintln!("usage: cargo xtask <check|lint|features|test|docs|bench|fuzz|{{ "package" if project_kind == "published_library" else "dist" }}|ci>");
        return ExitCode::from(2);
    };

    if args.next().is_some() {
        eprintln!("xtask commands do not accept positional arguments");
        return ExitCode::from(2);
    }

    match run(&task) {
        Ok(()) => ExitCode::SUCCESS,
        Err(error) => {
            eprintln!("{error}");
            ExitCode::FAILURE
        }
    }
}
